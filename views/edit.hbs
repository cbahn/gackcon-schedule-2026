<header class="row">
  <div>
    <h1>Edit Schedule</h1>
    <p class="muted">Timezone: <code>{{timezone}}</code></p>
  </div>
  <div class="right">
    <a href="/" role="button" class="secondary">Back</a>
  </div>
</header>

{{#if error}}
  <article class="notice error">{{error}}</article>
{{/if}}

<form method="post" action="/edit">
  <label>
    Admin password
    <input type="password" name="adminPassword" required />
  </label>

  <label>
    Schedule JSON
    <textarea name="scheduleJson" rows="18" required spellcheck="false">{{scheduleJson}}</textarea>
  </label>

  <button type="submit">Save</button>
</form>
